#!/usr/bin/env bash
set -euo pipefail

DEVICE="/dev/disk/by-id/google-ipfs-data"
MOUNT="/srv/ipfs"
mkdir -p "$MOUNT"
if ! blkid "$DEVICE" >/dev/null 2>&1; then mkfs.ext4 -F "$DEVICE"; fi
grep -q "$DEVICE" /etc/fstab || echo "$DEVICE $MOUNT ext4 defaults,nofail,discard 0 2" >> /etc/fstab
mountpoint -q "$MOUNT" || mount "$MOUNT"
mkdir -p "$MOUNT/repo" "$MOUNT/staging" /opt/orbitcid

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io docker-compose-plugin
systemctl enable --now docker

echo '${bridge_source}' | base64 -d > /opt/orbitcid/bridge.mjs
chmod 0600 /opt/orbitcid/bridge.mjs
cat > /opt/orbitcid/001-orbitcid.sh <<'EOF'
#!/bin/sh
set -eu
ipfs config --json Gateway.NoFetch true
EOF
chmod 0555 /opt/orbitcid/001-orbitcid.sh
cat > /opt/orbitcid/.env <<'EOF'
BRIDGE_TOKEN=${bridge_token}
CLOUDFLARED_TOKEN=${cloudflared_token}
ADMIN_ORIGIN=${admin_origin}
EOF
chmod 0600 /opt/orbitcid/.env

cat > /opt/orbitcid/compose.yaml <<'EOF'
services:
  kubo:
    image: ${kubo_image}
    restart: unless-stopped
    environment:
      IPFS_PROFILE: server
    volumes:
      - /srv/ipfs/repo:/data/ipfs
      - /opt/orbitcid/001-orbitcid.sh:/container-init.d/001-orbitcid.sh:ro
    ports:
      - "4001:4001/tcp"
      - "4001:4001/udp"
      - "127.0.0.1:5001:5001"
      - "127.0.0.1:8080:8080"
    healthcheck:
      test: ["CMD", "ipfs", "id"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 30s
    security_opt:
      - no-new-privileges:true
  bridge:
    image: node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
    restart: unless-stopped
    read_only: true
    environment:
      KUBO_API: http://kubo:5001
      KUBO_GATEWAY: http://kubo:8080
      PORT: "8788"
      TMPDIR: /var/lib/orbitcid
      BRIDGE_TOKEN: "$${BRIDGE_TOKEN}"
      ADMIN_ORIGIN: "$${ADMIN_ORIGIN}"
    volumes:
      - /opt/orbitcid/bridge.mjs:/app/bridge.mjs:ro
      - /srv/ipfs/staging:/var/lib/orbitcid
    command: ["node", "/app/bridge.mjs"]
    depends_on:
      kubo:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:8788/healthz',{headers:{Authorization:'Bearer '+process.env.BRIDGE_TOKEN}}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 10s
    security_opt:
      - no-new-privileges:true
  tunnel:
    image: cloudflare/cloudflared:2026.8.2@sha256:0aa26e284f05e6c77ae375b8c9c11d9eb6a448fb7bcd8d40f31cb6176189eb38
    restart: unless-stopped
    read_only: true
    command: ["tunnel", "--no-autoupdate", "run", "--token", "$${CLOUDFLARED_TOKEN}"]
    depends_on:
      bridge:
        condition: service_healthy
    security_opt:
      - no-new-privileges:true
EOF

cd /opt/orbitcid
docker compose up -d
