# Long random emergency/control-plane token (minimum 32 characters).
BRIDGE_TOKEN=

# Optional legacy Cloudflare control-plane origin used only for signed CAR replication.
ADMIN_ORIGIN=

# Public Vercel frontend origin and this backend's public HTTPS endpoint.
ORBITCID_FRONTEND_ORIGIN=
ORBITCID_BACKEND_PUBLIC_URL=

# Optional Cloudflare Tunnel token. A standard HTTPS reverse proxy can be used instead.
TUNNEL_TOKEN=

# Persistent Kubo and upload limits.
SWARM_PORT=
KUBO_API_PORT=
KUBO_GATEWAY_PORT=
AGENT_PORT=
MAX_CAR_BYTES=
MAX_UPLOAD_BYTES=
