{
  "name": "orbitcid",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "description": "Vercel and Neon control surface for secure, self-hosted Kubo IPFS infrastructure",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "typecheck": "tsc --noEmit && npm --workspace frontend run typecheck",
    "test": "vitest run --configLoader native --pool=threads --maxWorkers=1",
    "test:watch": "vitest",
    "security:release": "node scripts/check-public-release.mjs",
    "lint": "npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
