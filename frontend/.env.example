# Public application URL, for example https://orbitcid.example.com
BETTER_AUTH_URL=

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Google Cloud OAuth Web client. Never prefix either value with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pooled privileged database connection for authentication and migrations.
DATABASE_URL=

# Pooled database connection for the restricted tenant role.
TENANT_DATABASE_URL=

# Generate with: npm --workspace frontend run key:generate
ORBITCID_GRANT_PRIVATE_KEY=
ORBITCID_GRANT_PUBLIC_KEY=
ORBITCID_GRANT_KEY_ID=

# Comma-separated exact HTTPS origins. Include preview origins deliberately.
TRUSTED_ORIGINS=
